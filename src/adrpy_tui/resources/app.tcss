/* The $tui-* colors come from the appearance preset's theme
   (core/themes.py), so a preset can change them while running. */

AppHeader {
    height: auto;
}

AppHeader Rule {
    color: $tui-banner;
    margin: 0;
}

.banner {
    color: $tui-banner;
}

.info {
    color: $tui-info;
}

.warning {
    color: $tui-warning;
}

.summary {
    color: $tui-summary;
}

.error {
    color: $tui-error;
}

.result {
    color: $tui-result;
}

.title {
    text-style: bold;
    margin-top: 1;
}

#body {
    height: 1fr;
}

#hints {
    height: 1;
    color: $tui-info;
}

Input {
    color: $tui-value;
}

OptionList {
    height: auto;
    max-height: 20;
}

HelpScreen Markdown {
    color: $tui-help;
}

ConfirmScreen {
    align: center middle;
}

#dialog {
    width: 80%;
    height: auto;
    border: double $tui-banner;
    padding: 1 2;
    background: $surface;
}

#buttons {
    height: auto;
    margin-top: 1;
}
