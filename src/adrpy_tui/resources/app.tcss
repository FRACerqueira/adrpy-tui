/* The $tui-* colors come from the appearance preset's theme
   (core/themes.py), so a preset can change them while running. */

AppHeader {
    height: auto;
}

AppHeader Rule {
    color: $tui-banner;
    margin: 0;
}

.banner {
    color: $tui-banner;
}

.info {
    color: $tui-info;
}

.warning {
    color: $tui-warning;
}

.summary {
    color: $tui-summary;
}

.error {
    color: $tui-error;
}

.result {
    color: $tui-result;
}

.title {
    text-style: bold;
    margin-top: 1;
}

#body {
    height: 1fr;
}

/* Textual's Vertical is 1fr: the rows would share out the visible body,
   each cut to its share, and the body would never scroll. */
.field-row {
    height: auto;
}

/* A TextArea is 1fr too: in a scrolling body, a whole screen. */
.field-row TextArea {
    height: 10;
}

#hints {
    height: 1;
    color: $tui-info;
}

Input {
    color: $tui-value;
}

OptionList {
    height: auto;
    max-height: 20;
}

HelpScreen Markdown {
    color: $tui-help;
}

ConfirmScreen {
    align: center middle;
}

#command-scroll {
    height: auto;
    max-height: 50vh;
}

#dialog {
    width: 80%;
    height: auto;
    max-height: 100%;
    border: double $tui-banner;
    padding: 1 2;
    background: $surface;
}

#buttons {
    height: auto;
    margin-top: 1;
}

/* A toggle's label is text: the theme's own foreground, on any preset. */
RadioButton, Checkbox {
    color: $foreground;
}

/* A switch's slider is a component, WCAG's 3:1: the info role off, the
   highlighted-item role on, both on the cursor role. */
Switch > .switch--slider {
    color: $tui-info;
    background: $tui-cursor;
}

Switch.-on > .switch--slider {
    color: $tui-highlight;
}

/* A Markdown table's header: the theme's text in bold, as the headings --
   Textual's own is the primary color, a button's background. */
MarkdownTableContent > .header {
    color: $foreground;
    text-style: bold;
}

/* A select's arrow: Textual's is half the text (2.97:1 on Light). */
SelectCurrent .arrow {
    color: $text-muted;
}

/* The row under the mouse: underlined, apart from the highlighted one. */
OptionList > .option-list--option-hover {
    text-style: underline;
}

/* A select's open list: at most a page of rows plus its border, like
   every list (doc/forms.md, "Lists"). */
SelectOverlay {
    max-height: 10;
}
